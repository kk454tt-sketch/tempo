# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Session pooler). Used only by setup, verify:db and check:rls.
SUPABASE_DB_URL=

# Admin account created by `npm run setup` (use a strong password, 10+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public address of the site, no trailing slash (http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Shown as a mailto link on /contact. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=

# Timezone for analytics bucketing (defaults to Asia/Kolkata)
ANALYTICS_TZ=

# Rate limiting: long random string salting SHA-256 of visitor IPs (openssl rand -base64 32)
RATE_LIMIT_SALT=
# Optional on local dev, strongly recommended on Vercel for global rate limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron authentication: Vercel sends "Authorization: Bearer <CRON_SECRET>" (openssl rand -hex 32)
CRON_SECRET=
# Days to retain analytics events before cron cleanup
EVENT_RETENTION_DAYS=400
# Safety valve refusing cleanup if findOrphans() returns more than this count
ORPHAN_DELETE_MAX=500
# Storage bucket name for orphan cleanup
STORAGE_BUCKET=

# Content-Security-Policy mode: report-only (default) | enforce | off
CSP_MODE=report-only

# Optional Pinterest site verification token, Sentry DSN, and log level
NEXT_PUBLIC_PINTEREST_VERIFY=
SENTRY_DSN=
LOG_LEVEL=info

# Local-only test helpers (never set these on Vercel)
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_COUNTRY=US
E2E_EXPECTED_HOST=amazon.com
RLS_CHECK_USER_EMAIL=
RLS_CHECK_USER_PASSWORD=

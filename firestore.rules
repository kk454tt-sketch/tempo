rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Event Websites: public visitors can read published; owners can read/create/update/delete their own
    match /websites/{websiteId} {
      allow read: if resource.data.status == 'published' || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous' || !('userId' in resource.data));
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous');
    }

    // Saved Drafts
    match /drafts/{draftId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Template Unlocks (Per-User Purchases)
    match /unlocks/{unlockId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Payment Orders
    match /paymentOrders/{orderId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
    }

    // Subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // RSVPs
    match /rsvps/{rsvpId} {
      allow create: if true;
      allow read: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Guestbook Entries (Memory Wall)
    match /guestbookEntries/{entryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Portal Hubs (Study groups, superlative votes)
    match /portalHubs/{slug} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Payment Products (Catalog)
    match /paymentProducts/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Sensitive Payment Tables (Server-Only via Firebase Admin SDK)
    match /paymentTransactions/{document=**} {
      allow read, write: if false;
    }

    match /processedPaymentNotifications/{document=**} {
      allow read, write: if false;
    }

    match /paymentScanLock/{document=**} {
      allow read, write: if false;
    }

    match /paymentManualApprovals/{document=**} {
      allow read, write: if false;
    }

    match /paymentNotificationOutbox/{document=**} {
      allow read, write: if false;
    }
  }
}
